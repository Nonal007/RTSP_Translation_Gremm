<Window x:Class="RTSP_Translation_Gremm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RTSP_Translation_Gremm"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="Bold" Text="Контроль RTSP сервера"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Text="RTSP URL для проверки:" Margin="0,0,8,0"/>
            <TextBox x:Name="RtspUrlBox" Width="420"
                     Text="rtsp://127.0.0.1:554/screenlive"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Width="120" Margin="0,0,8,0" Content="Старт" Click="Start_Click"/>
            <Button Width="120" Margin="0,0,16,0" Content="Стоп" Click="Stop_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Статус: —"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,12,0,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Text="Лог"/>
                <ListBox x:Name="LogList"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
